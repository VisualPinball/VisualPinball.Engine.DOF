@@ -0,0 +1,155 @@
+#include "PathConfinement.h"
+
+#include <filesystem>
+#include <mutex>
+
+#include "../Log.h"
+
+namespace DOF
+{
+
+namespace
+{
+
+namespace fs = std::filesystem;
+
+struct Root
+{
+   // A root was given. Without one every path is allowed (upstream behavior).
+   bool set = false;
+   // The root resolved; until it does, nothing is allowed.
+   bool valid = false;
+   fs::path path;
+   // As given, so that a root that did not resolve (a folder not created yet) is looked up again on the next access.
+   std::string given;
+};
+
+std::mutex s_mutex;
+Root s_root;
+thread_local bool t_hasRoot = false;
+thread_local Root t_root;
+
+Root MakeRoot(const std::string& root)
+{
+   Root r;
+   if (root.empty())
+      return r;
+   r.set = true;
+   r.given = root;
+   std::error_code ec;
+   fs::path canonical = fs::canonical(fs::path(root), ec);
+   if (!ec && !canonical.empty())
+   {
+      r.valid = true;
+      r.path = canonical;
+   }
+   return r;
+}
+
+Root CurrentRoot()
+{
+   if (t_hasRoot)
+   {
+      if (t_root.set && !t_root.valid)
+         t_root = MakeRoot(t_root.given);
+      return t_root;
+   }
+   std::lock_guard<std::mutex> lock(s_mutex);
+   if (s_root.set && !s_root.valid)
+      s_root = MakeRoot(s_root.given);
+   return s_root;
+}
+
+// Resolves symbolic links and dot components of the parts that exist; the rest is normalized lexically. The result
+// stays a path: converting it to a narrow string can fail on Windows (a long name behind a short 8.3 path).
+bool Resolve(const std::string& path, fs::path& resolved)
+{
+   std::error_code ec;
+   fs::path absolute = fs::absolute(fs::path(path), ec);
+   if (ec)
+      return false;
+   resolved = fs::weakly_canonical(absolute, ec);
+   return !ec && !resolved.empty();
+}
+
+// Compares whole components, so neither a sibling with the same prefix ("config-other") nor a component that contains
+// a backslash on POSIX passes. Components compare exactly: canonical paths have the case of the file system.
+bool IsWithin(const fs::path& path, const fs::path& root)
+{
+   auto p = path.begin();
+   for (auto r = root.begin(); r != root.end(); ++r)
+   {
+      if (r->empty())
+         continue;
+      if (p == path.end() || *p != *r)
+         return false;
+      ++p;
+   }
+   for (; p != path.end(); ++p)
+   {
+      if (*p == fs::path(".."))
+         return false;
+   }
+   return true;
+}
+
+}
+
+void PathConfinement::SetRoot(const std::string& root)
+{
+   Root r = MakeRoot(root);
+   if (r.set && !r.valid)
+      Log::Warning("The configuration folder " + root + " cannot be resolved: no file will be read.");
+   std::lock_guard<std::mutex> lock(s_mutex);
+   s_root = r;
+}
+
+bool PathConfinement::HasRoot() { return CurrentRoot().set; }
+
+PathConfinement::ThreadRoot::ThreadRoot(const std::string& root)
+   : m_hadRoot(t_hasRoot)
+   , m_previous(new Root(t_root))
+{
+   t_root = MakeRoot(root);
+   t_hasRoot = true;
+}
+
+PathConfinement::ThreadRoot::~ThreadRoot()
+{
+   t_root = *static_cast<Root*>(m_previous);
+   t_hasRoot = m_hadRoot;
+   delete static_cast<Root*>(m_previous);
+}
+
+bool PathConfinement::IsReadAllowed(const std::string& path)
+{
+   Root root = CurrentRoot();
+   if (!root.set)
+      return true;
+   bool allowed = false;
+   if (root.valid && !path.empty())
+   {
+      try
+      {
+         fs::path resolved;
+         allowed = Resolve(path, resolved) && IsWithin(resolved, root.path);
+      }
+      catch (...)
+      {
+         allowed = false;
+      }
+   }
+   if (!allowed)
+      Log::Warning("Not reading " + path + ": it is outside the configuration folder.");
+   return allowed;
+}
+
+bool PathConfinement::IsWriteAllowed(const std::string& path)
+{
+   if (!HasRoot())
+      return true;
+   Log::Warning("Not writing or deleting " + path + ": the configuration folder is read-only.");
+   return false;
+}
+
+}
