+std::string HidString(const wchar_t* text)
+{
+   std::string result;
+   if (!text)
+      return result;
+#ifdef _WIN32
+   int size = WideCharToMultiByte(CP_UTF8, 0, text, -1, nullptr, 0, nullptr, nullptr);
+   if (size > 0)
+   {
+      result.resize(size - 1);
+      WideCharToMultiByte(CP_UTF8, 0, text, -1, &result[0], size, nullptr, nullptr);
+   }
+#else
+   while (*text)
+      result += static_cast<char>(*text++);
+#endif
+   return result;
+}
+
+}
+
+// The path of a device that was unplugged can belong to another device once it is back (hidraw nodes are reused), so
+// the interface is looked up again by what identifies it: the serial number, the product name and the interface FindDevices
+// chose. Until that interface opens, the device stays failed and has no handle.
+bool DudesCab::Device::Reopen()
+{
+   if (m_hidDevice)
+      hid_close(m_hidDevice);
+   m_hidDevice = nullptr;
+   m_lastWriteFailed = true;
+
+   // Without a serial number nothing tells this board from another one plugged in its place, so it is not reopened
+   // during the session; it stays failed until the next one enumerates the devices again.
+   if (m_serial.empty() || m_serial == "<not available>")
+      return false;
+   const char* candidate = nullptr;
+   struct hid_device_info* devs = hid_enumerate(m_vendorID, m_productID);
+   for (struct hid_device_info* cur = devs; cur; cur = cur->next)
+   {
+      std::string serial = cur->serial_number ? HidString(cur->serial_number) : "<not available>";
+      if (serial != m_serial || HidString(cur->product_string) != m_devicename)
+         continue;
+      RIDType rid = RIDType::None;
+      if (m_devicename == "DudesCab Outputs")
+         rid = RIDType::RIDOutputs;
+      else if (m_devicename == "DudesCab Outputs MX")
+         rid = RIDType::RIDOutputsMx;
+#if defined(__linux__) || defined(__APPLE__)
+      else if (m_devicename == "DudesCab" && cur->interface_number == 3)
+         rid = RIDType::RIDOutputs;
+      else if (m_devicename == "DudesCab" && cur->interface_number == 4)
+         rid = RIDType::RIDOutputsMx;
+#endif
+      if (rid != m_deviceRid)
+         continue;
+      candidate = cur->path;
+      break;
+   }
+   if (candidate)
+   {
+      m_hidDevice = hid_open_path(candidate);
+      if (m_hidDevice)
+         m_path = candidate;
+   }
+   hid_free_enumeration(devs);
+
+   if (!m_hidDevice)
+      return false;
+   m_lastWriteFailed = false;
+   return true;
+}
