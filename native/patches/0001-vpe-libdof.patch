+
+void Pinball::DrainCommands()
+{
+   // The input a command waits for is processed first, so an opening does not restore an output whose off came before it.
+   // Input queued after the last command is left: Finish turns everything off.
+   while (true)
+   {
+      std::function<void()> command;
+      TableElementData data;
+      Work work = TakeWork(true, command, data);
+      if (work == Work::None)
+         break;
+      if (work == Work::Command)
+         RunCommand(command);
+      else
+         ProcessInput(data);
+   }
+   // Commands whose input is gone.
+   while (true)
+   {
+      std::function<void()> command;
+      {
+         std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+         if (m_commands.empty())
+            return;
+         command = std::move(m_commands.front().run);
+         m_commands.pop_front();
+      }
+      RunCommand(command);
+   }
+}
+
+Pinball::Work Pinball::TakeWork(bool onlyForCommands, std::function<void()>& command, TableElementData& data)
+{
+   // One lock for the choice and the dequeue: what the host queues in between waits for the next call.
+   std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+   if (!m_commands.empty() && m_commands.front().inputsBefore <= 0)
+   {
+      command = std::move(m_commands.front().run);
+      m_commands.pop_front();
+      return Work::Command;
+   }
+   if ((onlyForCommands && m_commands.empty()) || m_inputQueue->Count() == 0)
+      return Work::None;
+   data = m_inputQueue->Dequeue();
+   for (Command& queued : m_commands)
+   {
+      if (queued.inputsBefore > 0)
+         queued.inputsBefore--;
+   }
+   return Work::Input;
+}
+
+void Pinball::RunCommand(std::function<void()>& command)
+{
+   try
+   {
+      command();
+   }
+   catch (const std::exception& e)
+   {
+      Log::Exception(StringExtensions::Build("An unhandled exception occured while running a host command: {0}", e.what()));
+   }
+   catch (...)
+   {
+      Log::Exception("An unhandled exception occured while running a host command");
+   }
+}
