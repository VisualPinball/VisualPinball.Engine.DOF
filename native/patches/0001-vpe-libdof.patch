diff --git a/src/cab/out/OutputGate.h b/src/cab/out/OutputGate.h
new file mode 100644
index 0000000..7ea71ed
--- /dev/null
+++ b/src/cab/out/OutputGate.h
@@ -0,0 +1,256 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace DOF
+{
+
+// Switch between the effects and the hardware, added for hosts that must be able to turn every output off without
+// losing the effect state (pause, faults). While the gate is closed, every output reports and sends 0; the values the
+// effects set are kept and sent again when it opens.
+//
+// A gate change gets a generation. DOF's main thread applies it (Pinball::SetOutputGate), and every output controller
+// unit acknowledges the state of a generation once a transfer to its hardware carried that state, so the host can tell
+// when the outputs are really off.
+//
+// Each session (one DOF instance, from its creation on) has its own gate object. Instance() is the current session's.
+// A gate is shared: the current session slot, the host's instance, Pinball and every unit handle (held by its controller
+// and copied by its updater thread) keep it, and it is freed with its history and units once none does. So a latch, a
+// unit or a hung updater thread of an ended session only ever reaches its own session, never the next one, and a host
+// that runs many sessions keeps only the gates something still uses.
+class OutputGate : public std::enable_shared_from_this<OutputGate>
+{
+public:
+   // A generation and the state it set, read together.
+   struct Snapshot
+   {
+      int64_t generation;
+      bool open;
+   };
+
+   enum class Status
+   {
+      // DOF's main thread did not apply the generation yet (a latch's own generation: it was not published yet).
+      NotApplied,
+      Applied,
+      // The generation never reached a unit as what it asked for: it is an opening applied after a latch, or a later
+      // generation that reached the units set the other state. This does not change any more: only the latest
+      // generation's state tells what the outputs show.
+      Superseded,
+   };
+
+   struct Counts
+   {
+      // Units whose hardware got the state (or a later generation of the same state).
+      int confirmed = 0;
+      int pending = 0;
+      // The device is missing, a write failed, or the updater ended on its own. A unit that finished cleanly keeps what
+      // it confirmed or left alone, and fails later generations.
+      int failed = 0;
+      // Units DOF never used, left alone while the gate is open: nothing was written to them.
+      int untouched = 0;
+   };
+
+   class Unit
+   {
+   public:
+      // Called by the unit's updater before it copies the values it sends, under the lock the values are set with. A unit
+      // registered while the gate was closed gets that closing until it confirmed or failed it, also once the gate
+      // opened: its device, which an earlier session may have left lit, is turned off before any opening reaches it.
+      Snapshot Observe() const;
+      // Whether the hardware already got the state of `snapshot`, or the gate is open at a unit DOF leaves alone; until
+      // then the updater transfers every output.
+      bool IsAcked(const Snapshot& snapshot) const;
+      // A transfer to the hardware carried the state of `snapshot`.
+      void Ack(const Snapshot& snapshot);
+      // A blackout that ends the unit's session got to the hardware: it confirms the closing observed before it was
+      // sent (`before`) and one published while it was sent. Then Stop.
+      void AckOff(const Snapshot& before);
+      // The gate is open at `snapshot` and DOF never used the unit, so nothing was written to its hardware.
+      void Untouched(const Snapshot& snapshot);
+      // The unit could not deliver `generation` (no device, failed write).
+      void Fail(int64_t generation);
+      // The unit's updater ended without being asked to: it fails every generation, also those it confirmed before.
+      void Die();
+      // The unit was finished, after its last transfer: it delivers nothing any more. What it confirmed stays confirmed.
+      void Stop();
+      // Whether the unit belongs to `gate`'s session.
+      bool BelongsTo(const OutputGate& gate) const { return m_gate == &gate; }
+
+   private:
+      friend class OutputGate;
+      OutputGate* m_gate = nullptr;
+      std::string m_name;
+      std::atomic<int64_t> m_ackedClosed { 0 };
+      std::atomic<int64_t> m_ackedOpen { 0 };
+      std::atomic<int64_t> m_untouched { 0 };
+      std::atomic<int64_t> m_failed { 0 };
+      std::atomic<bool> m_dead { false };
+      std::atomic<bool> m_stopped { false };
+      // The closing the gate was at when the unit registered, or 0 if it was open.
+      int64_t m_closedAtRegistration = 0;
+   };
+
+   // A unit, and with it its session's gate: the gate lives as long as any handle to one of its units.
+   using UnitHandle = std::shared_ptr<Unit>;
+
+   // A transfer of the values observed at `snapshot`, made by the calling thread while this exists. A latch overtakes
+   // the transfer of an opening: from then on TransferCancelled() is true, and every write point stops before it writes.
+   // A write already past its check when the latch came still goes out: at most that one write per controller, whose
+   // updater has one transfer at a time; no later one does. The transfer then stays unconfirmed and the updater sends
+   // the closing in full next.
+   class Transfer
+   {
+   public:
+      Transfer(const Unit* unit, const Snapshot& snapshot);
+      Transfer(const UnitHandle& unit, const Snapshot& snapshot)
+         : Transfer(unit.get(), snapshot)
+      {
+      }
+      ~Transfer();
+      Transfer(const Transfer&) = delete;
+      Transfer& operator=(const Transfer&) = delete;
+      // Whether a write point stopped because a latch overtook the transfer.
+      bool Cancelled() const { return m_cancelled; }
+
+   private:
+      friend class OutputGate;
+      const OutputGate* m_gate;
+      bool m_open;
+      bool m_cancelled = false;
+      Transfer* m_previous;
+   };
+
+   // Asked by every write point of an output controller right before it writes to its device (each report, each retry,
+   // after acknowledgements and handle acquisition): true once a latch overtook the calling thread's transfer, which
+   // must then stop without writing. False outside a transfer and for a closing.
+   static bool TransferCancelled();
+
+   // The current session's gate, kept by the session slot until the next session begins.
+   static OutputGate& Instance();
+   // Starts a new session with an open gate and returns it; Instance() returns it from now on. Generations go on from
+   // the previous session's. The slot lets go of the previous session's gate, which lives on while anything else holds
+   // it (see above). A caller that uses the gate beyond the session holds it with shared_from_this().
+   static OutputGate& BeginSession();
+
+   // The state outputs report. It changes before the generation that set it is published. The latch decides on its own,
+   // so an Apply that raced it cannot report the gate open again.
+   bool IsOpen() const { return !m_latched.load(std::memory_order_acquire) && m_open.load(std::memory_order_acquire); }
+   // Whether a controller may run its connect test sequence (TestOnConnect): only while the gate is open, and never in a
+   // session that turned them off, such as a port test, where a controller that connects late or reconnects would light
+   // its whole strip.
+   bool AllowsConnectTests() const { return IsOpen() && m_connectTests.load(std::memory_order_acquire); }
+   // Turns the connect test sequences off, or on again, for this session. Every new session allows them.
+   void SetConnectTests(bool allowed) { m_connectTests.store(allowed, std::memory_order_release); }
+   // The published generation and the state the units send for it: closed once latched, also before the latch's own
+   // generation is published.
+   Snapshot Current() const;
+
+   // Registers an output controller unit of this session, before anything is sent to its device. The unit and the
+   // gate live as long as the returned handle or one of its copies. Registered while the gate is closed, the unit sends
+   // that closing before any later opening (Unit::Observe).
+   UnitHandle Register(const std::string& name);
+   // Registers a configured unit that cannot deliver anything, such as a device that is not connected.
+   void RegisterFailed(const std::string& name);
+
+   // Reserves the generation of a change to `open` and records the requested state. Generations reserved once the
+   // session latched are closings.
+   int64_t Request(bool open);
+   // On DOF's main thread, in the order of the generations: sets the state outputs report and returns it, closed once
+   // latched. The caller re-raises the output values, then publishes the generation.
+   bool Apply(bool open);
+   // Publishes `generation` and decides what it reports (see GetState), once.
+   void Publish(int64_t generation);
+   // Any thread, at once: closes the gate for the rest of the session and publishes the closing, which every unit's
+   // updater sends within its polling interval, without DOF's main thread. The latch flag is set in the same step that
+   // reserves its generation, so every change reserved after it is a closing, whichever latch finishes first. Openings
+   // reserved before it that DOF's main thread applies after it never reach a unit as openings and report as superseded.
+   // Returns the closing's generation. It takes no lock and never allocates.
+   int64_t Latch();
+   bool IsLatched() const { return m_latched.load(std::memory_order_acquire); }
+   int64_t Applied() const { return Current().generation; }
+
+   // What a generation reports. It is decided when the generation is published, and never from what happens later,
+   // except that an applied one becomes superseded once a later generation that reached the units sets the other state.
+   Status GetState(int64_t generation, Counts& counts) const;
+   // The units GetState counts as pending or failed for `generation`.
+   std::vector<std::string> GetPending(int64_t generation) const;
+
+private:
+   friend class OutputGateTestAccess;
+
+   enum class UnitState
+   {
+      Confirmed,
+      Pending,
+      Failed,
+      Untouched,
+   };
+
+   struct Entry
+   {
+      // The state the generation asked for; a closing if it was reserved once the session latched.
+      bool open;
+      // Publish ran for it.
+      bool decided = false;
+      // The state it was published with: closed once latched.
+      bool publishedOpen = false;
+      // It became the published generation (not when a later one was published before it).
+      bool raised = false;
+   };
+
+   explicit OutputGate(int64_t lastGeneration);
+
+   // The published word: the generation, whether the session latched, and the state the units send for it.
+   static constexpr int64_t OpenBit = 1;
+   static constexpr int64_t LatchedBit = 2;
+   static int64_t Pack(int64_t generation, bool open, bool latched) { return (generation << 2) | (latched ? LatchedBit : 0) | (open ? OpenBit : 0); }
+
+   // The two halves of Latch: closes at once and reserves the generation with the latch flag, then publishes it.
+   int64_t BeginLatch();
+   void FinishLatch(int64_t generation);
+   // Takes the next generation; `latched`: the session latched before.
+   int64_t Reserve(bool& latched);
+
+   // Called with m_mutex held.
+   Status Evaluate(int64_t generation, Counts& counts, std::vector<std::string>* names) const;
+   // What `unit` reports for `generation`, for both the counts and the names. `known`: the generation was published
+   // and set `open`.
+   UnitState Classify(const Unit& unit, int64_t generation, bool open, bool known) const;
+   // Whether a generation after `generation`, up to `applied`, reached the units with the other state.
+   bool IsSuperseded(int64_t generation, bool open, int64_t applied) const;
+   // Records the state of a generation and forgets the oldest ones.
+   void Record(int64_t generation, const Entry& entry);
+   // Publishes `generation` unless a later one was published already, and returns whether it did. Lock-free. It goes
+   // out closed once the published word says latched, in the same step that publishes it: `sent` is the state it was
+   // published with, what Current() gave the units for it.
+   bool RaisePublished(int64_t generation, bool open, bool& sent);
+
+   std::atomic<bool> m_open { true };
+   std::atomic<bool> m_connectTests { true };
+   std::atomic<bool> m_latched { false };
+   // The last published generation, whether the session latched, and the state the units send: Pack. The latch sets
+   // its bit before it reserves its generation, so a generation is published either before the latch began, open if it
+   // asked to, or after, closed: what Publish records is what Current() gave the units.
+   std::atomic<int64_t> m_published { 0 };
+   // The last generation taken, and whether the session latched: (generation << 1) | latched.
+   std::atomic<int64_t> m_requested { 0 };
+   mutable std::mutex m_mutex;
+   // The state each generation reserved by Request set, the latest ones only. A latch's generation is not in it (the
+   // latch takes no lock): a generation that is not, newer than the oldest one recorded, is a latch's, a closing.
+   std::map<int64_t, Entry> m_history;
+   std::vector<std::unique_ptr<Unit>> m_units;
+
+   static constexpr size_t MaxHistory = 4096;
+
+   static_assert(std::atomic<int64_t>::is_always_lock_free);
+   static_assert(std::atomic<bool>::is_always_lock_free);
+};
+
+}
