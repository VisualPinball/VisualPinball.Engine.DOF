diff --git a/src/general/PathConfinement.cpp b/src/general/PathConfinement.cpp
new file mode 100644
index 0000000..cf5c187
--- /dev/null
+++ b/src/general/PathConfinement.cpp
@@ -0,0 +1,339 @@
+#include "PathConfinement.h"
+
+#include <filesystem>
+#include <mutex>
+#include <vector>
+#ifdef _WIN32
+#include <cwctype>
+#include <iterator>
+#include <wchar.h>
+#include <windows.h>
+#endif
+
+#include "../Log.h"
+
+namespace DOF
+{
+
+namespace
+{
+
+namespace fs = std::filesystem;
+
+struct Root
+{
+   // A root was given. Without one every path is allowed (upstream behavior).
+   bool set = false;
+   // The root resolved; until it does, nothing is allowed.
+   bool valid = false;
+   fs::path path;
+#ifdef _WIN32
+   // The volumes of the root as given and as resolved (VolumeOf). Only a path on one of them is looked up.
+   std::vector<std::wstring> volumes;
+#else
+   // The root as given (made absolute and normalized without the file system, so through the link the root was given
+   // through) and as resolved. Only a path written through one of them is looked up: a POSIX path does not tell whether
+   // it is on a network mount.
+   std::vector<fs::path> spellings;
+#endif
+   // As given, so that a root that did not resolve (a folder not created yet) is looked up again on the next access.
+   std::string given;
+};
+
+std::mutex s_mutex;
+Root s_root;
+thread_local bool t_hasRoot = false;
+thread_local Root t_root;
+
+// Absolute and normalized, from the path as written and the current folder only. On Windows, absolute() is
+// GetFullPathNameW, which does not touch the file system either.
+fs::path Lexical(const std::string& path)
+{
+   std::error_code ec;
+   fs::path absolute = fs::absolute(fs::path(path), ec);
+   if (ec)
+      return fs::path();
+   return absolute.lexically_normal();
+}
+
+#ifdef _WIN32
+bool SameName(const std::wstring& a, const std::wstring& b) { return _wcsicmp(a.c_str(), b.c_str()) == 0; }
+
+// The volume a drive letter ("C:") names, from the object manager alone: QueryDosDevice does not touch the volume, so
+// a mapped network drive that is gone does not block. A subst drive is followed to the drive it points into. Empty when
+// it is not a drive letter or names nothing.
+std::wstring Volume(const std::wstring& rootName)
+{
+   std::wstring drive = rootName;
+   for (int depth = 0; depth < 8; depth++)
+   {
+      if (drive.size() != 2 || drive[1] != L':' || !iswalpha(drive[0]))
+         return std::wstring();
+      wchar_t target[1024];
+      if (QueryDosDeviceW(drive.c_str(), target, static_cast<DWORD>(std::size(target))) == 0)
+         return std::wstring();
+      std::wstring device(target);
+      // A subst drive: \??\C:\folder.
+      if (device.size() >= 6 && device.compare(0, 4, L"\\??\\") == 0 && device[5] == L':')
+      {
+         drive = device.substr(4, 2);
+         continue;
+      }
+      return device;
+   }
+   return std::wstring();
+}
+
+bool StartsWith(const std::wstring& text, const wchar_t* prefix, bool ignoreCase = false)
+{
+   size_t length = wcslen(prefix);
+   if (text.size() < length)
+      return false;
+   return ignoreCase ? _wcsnicmp(text.c_str(), prefix, length) == 0 : text.compare(0, length, prefix) == 0;
+}
+
+// "server\share" of a UNC path after its leading backslashes, both required.
+std::wstring Share(const std::wstring& text)
+{
+   size_t server = text.find(L'\\');
+   if (server == 0 || server == std::wstring::npos)
+      return std::wstring();
+   size_t share = text.find(L'\\', server + 1);
+   std::wstring name = text.substr(0, share);
+   if (name.size() == server + 1)
+      return std::wstring();
+   return L"share:" + name;
+}
+
+std::wstring Drive(const std::wstring& text)
+{
+   if (text.size() < 2 || text[1] != L':' || !iswalpha(text[0]) || (text.size() > 2 && text[2] != L'\\'))
+      return std::wstring();
+   std::wstring drive = text.substr(0, 2);
+   std::wstring volume = Volume(drive);
+   return volume.empty() ? L"drive:" + drive : L"volume:" + volume;
+}
+
+// The volume an absolute path is on, from the path alone, so that nothing is looked up on a volume the root is not on:
+// the volume a drive letter names (a subst drive followed), or a share (server and share) for a UNC path. Paths in the
+// device namespaces are classified explicitly: "\\?\C:\" is drive C and "\\?\UNC\server\share\" that share; every other
+// one ("\\.\", "\??\", "\\?\Volume{...}\", "\\?\GLOBALROOT\") has none. Empty when the path has none, which refuses it.
+std::wstring Backslashed(const fs::path& path)
+{
+   std::wstring text = path.native();
+   for (wchar_t& c : text)
+   {
+      if (c == L'/')
+         c = L'\\';
+   }
+   return text;
+}
+
+std::wstring VolumeOf(const fs::path& path)
+{
+   std::wstring text = Backslashed(path);
+   if (StartsWith(text, L"\\\\?\\"))
+   {
+      std::wstring rest = text.substr(4);
+      if (StartsWith(rest, L"UNC\\", true))
+         return Share(rest.substr(4));
+      return Drive(rest);
+   }
+   if (StartsWith(text, L"\\\\.\\") || StartsWith(text, L"\\??\\"))
+      return std::wstring();
+   if (StartsWith(text, L"\\\\"))
+      return Share(text.substr(2));
+   return Drive(text);
+}
+
+void AddVolume(Root& r, const fs::path& path)
+{
+   std::wstring volume = VolumeOf(path);
+   if (volume.empty())
+      return;
+   for (const std::wstring& known : r.volumes)
+   {
+      if (SameName(known, volume))
+         return;
+   }
+   r.volumes.push_back(volume);
+}
+
+// Whether a path is on the volume of the root (as given or as resolved), decided without touching the file system.
+// Refuses other shares, also on the root's server, other volumes, and the device namespaces that name no volume, so
+// only a path that can be inside the root is looked up.
+bool OnRootVolume(const fs::path& lexical, const Root& root)
+{
+   std::wstring volume = VolumeOf(lexical);
+   if (volume.empty())
+      return false;
+   for (const std::wstring& known : root.volumes)
+   {
+      if (SameName(known, volume))
+         return true;
+   }
+   return false;
+}
+#endif
+
+Root MakeRoot(const std::string& root)
+{
+   Root r;
+   if (root.empty())
+      return r;
+   r.set = true;
+   r.given = root;
+   std::error_code ec;
+   fs::path canonical = fs::canonical(fs::path(root), ec);
+   if (!ec && !canonical.empty())
+   {
+      r.valid = true;
+      r.path = canonical;
+      fs::path given = Lexical(root);
+#ifdef _WIN32
+      AddVolume(r, given);
+      AddVolume(r, canonical);
+#else
+      for (const fs::path& spelling : { given, canonical })
+      {
+         if (!spelling.empty() && spelling.is_absolute())
+            r.spellings.push_back(spelling);
+      }
+#endif
+   }
+   return r;
+}
+
+Root CurrentRoot()
+{
+   if (t_hasRoot)
+   {
+      if (t_root.set && !t_root.valid)
+         t_root = MakeRoot(t_root.given);
+      return t_root;
+   }
+   std::lock_guard<std::mutex> lock(s_mutex);
+   if (s_root.set && !s_root.valid)
+      s_root = MakeRoot(s_root.given);
+   return s_root;
+}
+
+// Compares whole components, so neither a sibling with the same prefix ("config-other") nor a component that contains
+// a backslash on POSIX passes. Exactly: resolved paths have the spelling and case of the file system.
+bool IsWithin(const fs::path& path, const fs::path& root)
+{
+   auto p = path.begin();
+   for (auto r = root.begin(); r != root.end(); ++r)
+   {
+      if (r->empty())
+         continue;
+      if (p == path.end() || *p != *r)
+         return false;
+      ++p;
+   }
+   for (; p != path.end(); ++p)
+   {
+      if (*p == fs::path(".."))
+         return false;
+   }
+   return true;
+}
+
+// The decision for a path. First on the path as written, made absolute and normalized without the file system: a path
+// that must not be looked up is refused (see PathConfinement::IsReadAllowed). Then by identity: the path
+// is resolved and must be inside the resolved root. Two paths name the same folder when they resolve to the same path,
+// whatever their spelling (8.3 or long names per component, case, junctions, links, subst drives), so no spelling is
+// compared. What is resolved is the path the caller opens, not its normalized form: on POSIX a ".." after a symbolic
+// link leaves the link's target ("link/../x" is next to the target, not next to the link), so the normalized path can
+// be inside while the file opened is not. Resolving the path as written follows its links in the order the system does
+// when it opens it. The resolved path stays a path: converting it to a narrow string can fail on Windows (a long name
+// behind a short 8.3 path).
+bool IsInside(const std::string& path, const Root& root)
+{
+   fs::path lexical = Lexical(path);
+   if (lexical.empty())
+      return false;
+#ifdef _WIN32
+   // "\??\" is the NT namespace, checked on the path as written: GetFullPathName takes it for a folder on the current
+   // drive, while the file is opened through it.
+   if (StartsWith(Backslashed(fs::path(path)), L"\\??\\") || !OnRootVolume(lexical, root))
+      return false;
+#else
+   bool written = false;
+   for (const fs::path& spelling : root.spellings)
+      written = written || IsWithin(lexical, spelling);
+   if (!written)
+      return false;
+#endif
+   std::error_code ec;
+   fs::path absolute = fs::absolute(fs::path(path), ec);
+   if (ec || absolute.empty())
+      return false;
+   fs::path resolved = fs::weakly_canonical(absolute, ec);
+   return !ec && !resolved.empty() && IsWithin(resolved, root.path);
+}
+
+bool IsAllowed(const std::string& path)
+{
+   Root root = CurrentRoot();
+   if (!root.set)
+      return true;
+   if (!root.valid || path.empty())
+      return false;
+   try
+   {
+      return IsInside(path, root);
+   }
+   catch (...)
+   {
+      return false;
+   }
+}
+
+}
+
+void PathConfinement::SetRoot(const std::string& root)
+{
+   Root r = MakeRoot(root);
+   if (r.set && !r.valid)
+      Log::Warning("The configuration folder " + root + " cannot be resolved: no file will be read.");
+   std::lock_guard<std::mutex> lock(s_mutex);
+   s_root = r;
+}
+
+bool PathConfinement::HasRoot() { return CurrentRoot().set; }
+
+PathConfinement::ThreadRoot::ThreadRoot(const std::string& root)
+   : m_hadRoot(t_hasRoot)
+   , m_previous(new Root(t_root))
+{
+   t_root = MakeRoot(root);
+   t_hasRoot = true;
+}
+
+PathConfinement::ThreadRoot::~ThreadRoot()
+{
+   t_root = *static_cast<Root*>(m_previous);
+   t_hasRoot = m_hadRoot;
+   delete static_cast<Root*>(m_previous);
+}
+
+bool PathConfinement::IsReadAllowed(const std::string& path)
+{
+   bool allowed = IsAllowed(path);
+   if (!allowed)
+      Log::Warning("Not reading " + path + ": it is outside the configuration folder.");
+   return allowed;
+}
+
+bool PathConfinement::IsLookupAllowed(const std::string& path) { return IsAllowed(path); }
+
+bool PathConfinement::IsWriteAllowed(const std::string& path)
+{
+   if (!HasRoot())
+      return true;
+   Log::Warning("Not writing or deleting " + path + ": the configuration folder is read-only.");
+   return false;
+}
+
+}
diff --git a/src/general/PathConfinement.h b/src/general/PathConfinement.h
new file mode 100644
index 0000000..d0402db
--- /dev/null
+++ b/src/general/PathConfinement.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <string>
+
+namespace DOF
+{
+
+// VPE: keeps libdof's file access inside one folder. Configurations are imported from elsewhere, and their paths and
+// placeholders must not make libdof read files outside the folder they were imported into, or write or delete any file.
+// The file classes (FileInfo, DirectoryInfo, FileReader) ask it before every access, so a path outside the folder is
+// neither read nor looked up.
+class PathConfinement
+{
+public:
+   // Folder that reads are limited to. Empty allows every path (upstream behavior); writes and deletions are always
+   // refused while a root is set. A root that does not resolve allows nothing, and is looked up again on every access.
+   static void SetRoot(const std::string& root);
+   static bool HasRoot();
+   // Whether the path names a file or folder inside the root. Some paths are refused from the path as written, without
+   // being looked up, so a network share is never touched: on Windows one on another volume or share (server and share
+   // compared, "\\?\" and "\\?\UNC\" paths by the drive or share they name) or in a device namespace that names neither
+   // ("\\.\"), on POSIX, where a path does not tell whether it is on a network mount, one not written through the root
+   // as given or as resolved. Every other path is resolved (symbolic links, junctions, dot components, on Windows also
+   // 8.3 short names and case) and must be inside the resolved root: any spelling of the root's folder counts. Any error
+   // denies. Logs a refusal.
+   static bool IsReadAllowed(const std::string& path);
+   // The same check without the log line, for lookups (whether a file exists, its size, a folder's entries).
+   static bool IsLookupAllowed(const std::string& path);
+   static bool IsWriteAllowed(const std::string& path);
+
+   // Confines the calling thread to another root while it exists (catalog queries next to a running session).
+   class ThreadRoot
+   {
+   public:
+      explicit ThreadRoot(const std::string& root);
+      ~ThreadRoot();
+
+   private:
+      bool m_hadRoot;
+      void* m_previous;
+   };
+};
+
+}
