--- /dev/null
+++ b/src/cab/out/OutputGate.cpp
@@ -0,0 +1,379 @@
+#include "OutputGate.h"
+
+#include <cstdint>
+
+namespace DOF
+{
+
+namespace
+{
+
+void RaiseTo(std::atomic<int64_t>& value, int64_t generation)
+{
+   int64_t current = value.load(std::memory_order_relaxed);
+   while (current < generation && !value.compare_exchange_weak(current, generation, std::memory_order_release, std::memory_order_relaxed))
+   {
+   }
+}
+
+std::mutex s_sessionMutex;
+
+// The current session's gate, read without a lock by Instance().
+std::atomic<OutputGate*>& CurrentSession()
+{
+   static std::atomic<OutputGate*> current { nullptr };
+   return current;
+}
+
+// What keeps the current session's gate; replaced, under s_sessionMutex, when the next session begins. Never destroyed,
+// so a thread that ends after the static destructors still finds its gate.
+std::shared_ptr<OutputGate>& CurrentOwner()
+{
+   static std::shared_ptr<OutputGate>* owner = new std::shared_ptr<OutputGate>();
+   return *owner;
+}
+
+thread_local OutputGate::Transfer* t_transfer = nullptr;
+
+}
+
+OutputGate::Snapshot OutputGate::Unit::Observe() const
+{
+   Snapshot current = m_gate->Current();
+   // The closing in force when the unit registered stays in force for it until it confirmed or failed it: a session
+   // that starts closed starts dark on every unit, also on one whose first update comes after the gate opened.
+   int64_t closed = m_closedAtRegistration;
+   if (current.open && closed != 0 && m_ackedClosed.load(std::memory_order_acquire) < closed && m_failed.load(std::memory_order_acquire) < closed)
+      return { closed, false };
+   return current;
+}
+
+bool OutputGate::Unit::IsAcked(const Snapshot& snapshot) const
+{
+   const std::atomic<int64_t>& acked = snapshot.open ? m_ackedOpen : m_ackedClosed;
+   return acked.load(std::memory_order_acquire) >= snapshot.generation || (snapshot.open && m_untouched.load(std::memory_order_acquire) >= snapshot.generation);
+}
+
+void OutputGate::Unit::Ack(const Snapshot& snapshot) { RaiseTo(snapshot.open ? m_ackedOpen : m_ackedClosed, snapshot.generation); }
+
+void OutputGate::Unit::AckOff(const Snapshot& before)
+{
+   if (!before.open)
+      Ack(before);
+   // Nothing is sent after the blackout, so a closing published while it was sent is what the hardware shows too.
+   Snapshot after = Observe();
+   if (!after.open)
+      Ack(after);
+}
+
+void OutputGate::Unit::Untouched(const Snapshot& snapshot)
+{
+   if (snapshot.open)
+      RaiseTo(m_untouched, snapshot.generation);
+}
+
+void OutputGate::Unit::Fail(int64_t generation) { RaiseTo(m_failed, generation); }
+
+void OutputGate::Unit::Die()
+{
+   m_dead.store(true, std::memory_order_release);
+   Fail(INT64_MAX);
+}
+
+void OutputGate::Unit::Stop() { m_stopped.store(true, std::memory_order_release); }
+
+OutputGate::Transfer::Transfer(const Unit* unit, const Snapshot& snapshot)
+   : m_gate(unit ? unit->m_gate : nullptr)
+   , m_open(snapshot.open)
+   , m_previous(t_transfer)
+{
+   t_transfer = this;
+}
+
+OutputGate::Transfer::~Transfer() { t_transfer = m_previous; }
+
+bool OutputGate::TransferCancelled()
+{
+   Transfer* transfer = t_transfer;
+   if (!transfer || !transfer->m_open || !transfer->m_gate || !transfer->m_gate->IsLatched())
+      return false;
+   transfer->m_cancelled = true;
+   return true;
+}
+
+OutputGate::OutputGate(int64_t lastGeneration)
+{
+   // The session's first generation, open and published.
+   int64_t generation = lastGeneration + 1;
+   m_requested.store(generation << 1, std::memory_order_relaxed);
+   m_published.store(Pack(generation, true, false), std::memory_order_relaxed);
+   Entry entry;
+   entry.open = true;
+   entry.decided = true;
+   entry.publishedOpen = true;
+   entry.raised = true;
+   Record(generation, entry);
+}
+
+OutputGate& OutputGate::Instance()
+{
+   OutputGate* gate = CurrentSession().load(std::memory_order_acquire);
+   if (gate)
+      return *gate;
+   std::lock_guard<std::mutex> lock(s_sessionMutex);
+   gate = CurrentSession().load(std::memory_order_acquire);
+   if (!gate)
+   {
+      CurrentOwner() = std::shared_ptr<OutputGate>(new OutputGate(0));
+      gate = CurrentOwner().get();
+      CurrentSession().store(gate, std::memory_order_release);
+   }
+   return *gate;
+}
+
+OutputGate& OutputGate::BeginSession()
+{
+   OutputGate& previous = Instance();
+   std::lock_guard<std::mutex> lock(s_sessionMutex);
+   std::shared_ptr<OutputGate> gate(new OutputGate(previous.m_requested.load(std::memory_order_acquire) >> 1));
+   CurrentSession().store(gate.get(), std::memory_order_release);
+   // The previous gate is freed here unless its instance, its Pinball or a unit handle (a controller, an updater thread
+   // that still runs) holds it.
+   CurrentOwner() = gate;
+   return *gate;
+}
+
+OutputGate::Snapshot OutputGate::Current() const
+{
+   // The state comes from the published word alone, so it is the state Publish recorded for the generation.
+   int64_t word = m_published.load(std::memory_order_acquire);
+   return { word >> 2, (word & OpenBit) != 0 && (word & LatchedBit) == 0 };
+}
+
+OutputGate::UnitHandle OutputGate::Register(const std::string& name)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto unit = std::make_unique<Unit>();
+   unit->m_gate = this;
+   unit->m_name = name;
+   Snapshot current = Current();
+   if (!current.open)
+      unit->m_closedAtRegistration = current.generation;
+   Unit* result = unit.get();
+   m_units.push_back(std::move(unit));
+   // Shares the gate's ownership: the gate owns its units, the handle keeps the gate.
+   return UnitHandle(shared_from_this(), result);
+}
+
+void OutputGate::RegisterFailed(const std::string& name) { Register(name)->Die(); }
+
+int64_t OutputGate::Reserve(bool& latched)
+{
+   // The latch flag shares the word with the counter, so a generation is taken either before the session's latch or
+   // after it, never in between.
+   int64_t word = m_requested.fetch_add(2, std::memory_order_acq_rel);
+   latched = (word & 1) != 0;
+   return (word >> 1) + 1;
+}
+
+int64_t OutputGate::Request(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   bool latched;
+   int64_t generation = Reserve(latched);
+   // A change reserved once the session latched is a closing, from the start. One reserved before stays what it asked
+   // for, and Publish decides whether it got to the units as that.
+   Entry entry;
+   entry.open = open && !latched;
+   Record(generation, entry);
+   return generation;
+}
+
+void OutputGate::Record(int64_t generation, const Entry& entry)
+{
+   m_history[generation] = entry;
+   while (m_history.size() > MaxHistory)
+      m_history.erase(m_history.begin());
+}
+
+bool OutputGate::Apply(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   if (m_latched.load(std::memory_order_acquire))
+      open = false;
+   m_open.store(open, std::memory_order_release);
+   // A latch that came after the check above wins: it does not take the mutex.
+   if (open && m_latched.load(std::memory_order_acquire))
+   {
+      m_open.store(false, std::memory_order_release);
+      open = false;
+   }
+   return open;
+}
+
+int64_t OutputGate::BeginLatch()
+{
+   m_latched.store(true, std::memory_order_release);
+   m_open.store(false, std::memory_order_release);
+   // From here on every generation is published closed, and Current() reports closed: in one step with a publication
+   // that raced it, so an opening is either published before this, open, or after it, closed.
+   m_published.fetch_or(LatchedBit, std::memory_order_acq_rel);
+   // Takes the generation and sets the latch flag in one step: every generation taken after it is recorded as a closing
+   // (Request), whenever this latch publishes.
+   int64_t word = m_requested.load(std::memory_order_acquire);
+   while (!m_requested.compare_exchange_weak(word, (((word >> 1) + 1) << 1) | 1, std::memory_order_acq_rel, std::memory_order_acquire))
+   {
+   }
+   return (word >> 1) + 1;
+}
+
+void OutputGate::FinishLatch(int64_t generation)
+{
+   // Published at once, so the updaters send zeros without waiting for the main thread. Until then the latch's
+   // generation reports as not applied; it is a closing either way.
+   bool sent;
+   RaisePublished(generation, false, sent);
+}
+
+int64_t OutputGate::Latch()
+{
+   // No lock: a fault handler may run while another thread holds the gate's mutex. The history is not touched: a
+   // generation the history does not hold is a latch's (see m_history).
+   int64_t generation = BeginLatch();
+   FinishLatch(generation);
+   return generation;
+}
+
+bool OutputGate::RaisePublished(int64_t generation, bool open, bool& sent)
+{
+   int64_t current = m_published.load(std::memory_order_acquire);
+   while ((current >> 2) < generation)
+   {
+      // The latched bit is carried over: once set, it stays.
+      bool latched = (current & LatchedBit) != 0;
+      if (m_published.compare_exchange_weak(current, Pack(generation, open && !latched, latched), std::memory_order_acq_rel, std::memory_order_acquire))
+      {
+         sent = open && !latched;
+         return true;
+      }
+   }
+   sent = open && (current & LatchedBit) == 0;
+   return false;
+}
+
+void OutputGate::Publish(int64_t generation)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto it = m_history.find(generation);
+   bool requested = it != m_history.end() ? it->second.open : m_open.load(std::memory_order_acquire);
+   // Whether the session latched is decided in the step that publishes, not read before it: a latch that began in
+   // between makes it go out closed.
+   bool open;
+   bool raised = RaisePublished(generation, requested, open);
+   // What it reports is decided here, from what was published, and kept: nothing installed later changes it.
+   if (it != m_history.end() && !it->second.decided)
+   {
+      it->second.decided = true;
+      it->second.publishedOpen = open;
+      it->second.raised = raised;
+   }
+}
+
+bool OutputGate::IsSuperseded(int64_t generation, bool open, int64_t applied) const
+{
+   // Only changes that reached the units supersede: one that never became the published generation changed nothing.
+   int64_t recorded = 0;
+   for (auto it = m_history.upper_bound(generation); it != m_history.end() && it->first <= applied; ++it)
+   {
+      if (it->second.raised && it->second.publishedOpen != open)
+         return true;
+      recorded++;
+   }
+   // The generations in between that the history does not hold are latches': closings, each published or overtaken by
+   // a later published one, which is a closing too.
+   return open && applied - generation > recorded;
+}
+
+OutputGate::UnitState OutputGate::Classify(const Unit& unit, int64_t generation, bool open, bool known) const
+{
+   // An updater that ended on its own delivers nothing any more, whatever it confirmed before.
+   if (unit.m_dead.load(std::memory_order_acquire))
+      return UnitState::Failed;
+   // A later generation of the same state confirms this one too: the hardware has that state.
+   if (known && (open ? unit.m_ackedOpen : unit.m_ackedClosed).load(std::memory_order_acquire) >= generation)
+      return UnitState::Confirmed;
+   if (unit.m_failed.load(std::memory_order_acquire) >= generation)
+      return UnitState::Failed;
+   if (known && open && unit.m_untouched.load(std::memory_order_acquire) >= generation)
+      return UnitState::Untouched;
+   // Finished cleanly: what it confirmed or left alone stays so, and it delivers nothing later.
+   if (unit.m_stopped.load(std::memory_order_acquire))
+      return UnitState::Failed;
+   return UnitState::Pending;
+}
+
+OutputGate::Status OutputGate::Evaluate(int64_t generation, Counts& counts, std::vector<std::string>* names) const
+{
+   counts = Counts();
+   int64_t applied = Applied();
+   int64_t oldest = m_history.empty() ? 0 : m_history.begin()->first;
+   auto it = m_history.find(generation);
+
+   Status status;
+   bool open = false;
+   bool known = false;
+   if (it != m_history.end())
+   {
+      const Entry& entry = it->second;
+      open = entry.open;
+      known = entry.decided;
+      if (!entry.decided)
+         status = Status::NotApplied;
+      else if (entry.open && !entry.publishedOpen)
+         // An opening a latch overtook: it went out as a closing.
+         status = Status::Superseded;
+      else
+         status = IsSuperseded(generation, open, applied) ? Status::Superseded : Status::Applied;
+   }
+   else if (generation > oldest && generation <= (m_requested.load(std::memory_order_acquire) >> 1))
+   {
+      // A latch's generation: a closing, applied once it or a later generation was published.
+      known = generation <= applied;
+      status = known ? Status::Applied : Status::NotApplied;
+   }
+   else
+      // Never taken, or forgotten long ago.
+      status = generation > applied ? Status::NotApplied : Status::Superseded;
+
+   for (const auto& unit : m_units)
+   {
+      UnitState state = Classify(*unit, generation, open, known);
+      switch (state)
+      {
+      case UnitState::Confirmed: counts.confirmed++; break;
+      case UnitState::Failed: counts.failed++; break;
+      case UnitState::Untouched: counts.untouched++; break;
+      default: counts.pending++; break;
+      }
+      if (names && (state == UnitState::Pending || state == UnitState::Failed))
+         names->push_back(unit->m_name);
+   }
+   return status;
+}
+
+OutputGate::Status OutputGate::GetState(int64_t generation, Counts& counts) const
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   return Evaluate(generation, counts, nullptr);
+}
+
+std::vector<std::string> OutputGate::GetPending(int64_t generation) const
+{
+   std::vector<std::string> names;
+   Counts counts;
+   std::lock_guard<std::mutex> lock(m_mutex);
+   Evaluate(generation, counts, &names);
+   return names;
+}
