diff --git a/src/cab/out/OutputGate.cpp b/src/cab/out/OutputGate.cpp
new file mode 100644
index 0000000..41909e6
--- /dev/null
+++ b/src/cab/out/OutputGate.cpp
@@ -0,0 +1,291 @@
+#include "OutputGate.h"
+
+#include <cstdint>
+
+namespace DOF
+{
+
+namespace
+{
+
+void RaiseTo(std::atomic<int64_t>& value, int64_t generation)
+{
+   int64_t current = value.load(std::memory_order_relaxed);
+   while (current < generation && !value.compare_exchange_weak(current, generation, std::memory_order_release, std::memory_order_relaxed))
+   {
+   }
+}
+
+}
+
+OutputGate::Snapshot OutputGate::Unit::Observe() const { return OutputGate::Instance().Current(); }
+
+bool OutputGate::Unit::IsAcked(const Snapshot& snapshot) const
+{
+   const std::atomic<int64_t>& acked = snapshot.open ? m_ackedOpen : m_ackedClosed;
+   return acked.load(std::memory_order_acquire) >= snapshot.generation || (snapshot.open && m_untouched.load(std::memory_order_acquire) >= snapshot.generation);
+}
+
+void OutputGate::Unit::Ack(const Snapshot& snapshot) { RaiseTo(snapshot.open ? m_ackedOpen : m_ackedClosed, snapshot.generation); }
+
+void OutputGate::Unit::Untouched(const Snapshot& snapshot)
+{
+   if (snapshot.open)
+      RaiseTo(m_untouched, snapshot.generation);
+}
+
+void OutputGate::Unit::Fail(int64_t generation) { RaiseTo(m_failed, generation); }
+
+void OutputGate::Unit::Die()
+{
+   m_dead.store(true, std::memory_order_release);
+   Fail(INT64_MAX);
+}
+
+void OutputGate::Unit::Stop() { m_stopped.store(true, std::memory_order_release); }
+
+OutputGate& OutputGate::Instance()
+{
+   static OutputGate instance;
+   return instance;
+}
+
+OutputGate::Snapshot OutputGate::Current() const
+{
+   int64_t word = m_published.load(std::memory_order_acquire);
+   return { word >> 1, (word & 1) != 0 };
+}
+
+void OutputGate::BeginSession()
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   m_session++;
+   m_history.clear();
+   // The new session's first generation, with the latch flag cleared.
+   int64_t generation = (m_requested.load(std::memory_order_acquire) >> 1) + 1;
+   m_requested.store(generation << 1, std::memory_order_release);
+   Record(generation, true, true);
+   m_latched.store(false, std::memory_order_release);
+   m_latchGeneration.store(0, std::memory_order_release);
+   m_open.store(true, std::memory_order_release);
+   m_connectTests.store(true, std::memory_order_release);
+   m_published.store(Pack(generation, true), std::memory_order_release);
+   // Units of earlier sessions stay allocated, since a hung updater thread of an abandoned session may still use its
+   // unit, but they are no longer scanned.
+   for (auto& unit : m_units)
+      m_retired.push_back(std::move(unit));
+   m_units.clear();
+}
+
+OutputGate::Unit* OutputGate::Register(const std::string& name)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto unit = std::make_unique<Unit>();
+   unit->m_name = name;
+   unit->m_session = m_session;
+   Unit* result = unit.get();
+   m_units.push_back(std::move(unit));
+   return result;
+}
+
+void OutputGate::RegisterFailed(const std::string& name) { Register(name)->Die(); }
+
+int64_t OutputGate::Reserve(bool& latched)
+{
+   // The latch flag shares the word with the counter, so a generation is taken either before the session's first latch
+   // or after it, never in between.
+   int64_t word = m_requested.fetch_add(2, std::memory_order_acq_rel);
+   latched = (word & 1) != 0;
+   return (word >> 1) + 1;
+}
+
+int64_t OutputGate::Request(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   bool latched;
+   int64_t generation = Reserve(latched);
+   // A change requested once a latch took its generation is a closing, from the start. One taken before stays what it
+   // asked for, also when a latch comes before it is recorded.
+   Record(generation, open && !latched, false);
+   return generation;
+}
+
+void OutputGate::Record(int64_t generation, bool open, bool published)
+{
+   m_history[generation] = { open, published };
+   while (m_history.size() > MaxHistory)
+      m_history.erase(m_history.begin());
+}
+
+bool OutputGate::Apply(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   if (m_latched.load(std::memory_order_acquire))
+      open = false;
+   m_open.store(open, std::memory_order_release);
+   // A latch that came after the check above wins: it does not take the mutex.
+   if (open && m_latched.load(std::memory_order_acquire))
+   {
+      m_open.store(false, std::memory_order_release);
+      open = false;
+   }
+   return open;
+}
+
+int64_t OutputGate::BeginLatch()
+{
+   m_latched.store(true, std::memory_order_release);
+   m_open.store(false, std::memory_order_release);
+   // Takes the generation and sets the latch flag in one step: every generation taken after it is recorded as a closing
+   // (Request), so what a change reports does not depend on when this latch gets to install its generation below.
+   int64_t word = m_requested.load(std::memory_order_acquire);
+   while (!m_requested.compare_exchange_weak(word, (((word >> 1) + 1) << 1) | 1, std::memory_order_acq_rel, std::memory_order_acquire))
+   {
+   }
+   return (word >> 1) + 1;
+}
+
+void OutputGate::FinishLatch(int64_t generation)
+{
+   // The earliest latch generation of the session, whichever latch gets here first. Only latch generations are decided
+   // by it: requested ones carry their state in the history. Until it is installed, the latch's generation is not
+   // published either, so it reports as not applied.
+   int64_t current = m_latchGeneration.load(std::memory_order_acquire);
+   while ((current == 0 || current > generation)
+      && !m_latchGeneration.compare_exchange_weak(current, generation, std::memory_order_acq_rel, std::memory_order_acquire))
+   {
+   }
+   // Published at once, so the updaters send zeros without waiting for the main thread.
+   RaisePublished(generation, false);
+}
+
+int64_t OutputGate::Latch()
+{
+   // No lock: a fault handler may run while another thread holds the gate's mutex. The history is not touched; the
+   // latch generation tells which generations are closings (StateOf), and an opening that the main thread applies after
+   // this is not published as an opening.
+   int64_t generation = BeginLatch();
+   FinishLatch(generation);
+   return generation;
+}
+
+bool OutputGate::RaisePublished(int64_t generation, bool open)
+{
+   int64_t current = m_published.load(std::memory_order_relaxed);
+   int64_t word = Pack(generation, open);
+   while ((current >> 1) < generation)
+   {
+      if (m_published.compare_exchange_weak(current, word, std::memory_order_release, std::memory_order_relaxed))
+         return true;
+   }
+   return false;
+}
+
+void OutputGate::Publish(int64_t generation)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto it = m_history.find(generation);
+   bool requested = it != m_history.end() ? it->second.open : m_open.load(std::memory_order_acquire);
+   bool open = requested && !m_latched.load(std::memory_order_acquire);
+   // Only a generation that became the published one with the state it asked for counts as published: an opening a
+   // latch turned into a closing, or one a latch overtook, never reached a unit as an opening.
+   if (RaisePublished(generation, open) && it != m_history.end() && open == requested)
+      it->second.published = true;
+}
+
+bool OutputGate::StateOf(int64_t generation, bool& open) const
+{
+   int64_t latchGeneration = m_latchGeneration.load(std::memory_order_acquire);
+   if (latchGeneration > 0 && generation >= latchGeneration)
+   {
+      open = false;
+      return true;
+   }
+   auto it = m_history.find(generation);
+   if (it == m_history.end())
+      return false;
+   open = it->second.open;
+   return true;
+}
+
+bool OutputGate::IsSuperseded(int64_t generation, bool open, int64_t applied) const
+{
+   // An opening the latch overtook.
+   int64_t latchGeneration = m_latchGeneration.load(std::memory_order_acquire);
+   if (open && latchGeneration > generation && latchGeneration <= applied)
+      return true;
+   // Only changes that were published supersede: one that never reached a unit changed nothing.
+   for (auto it = m_history.upper_bound(generation); it != m_history.end() && it->first <= applied; ++it)
+   {
+      bool state;
+      if (it->second.published && StateOf(it->first, state) && state != open)
+         return true;
+   }
+   return false;
+}
+
+OutputGate::UnitState OutputGate::Classify(const Unit& unit, int64_t generation, bool open, bool known) const
+{
+   // An updater that ended on its own delivers nothing any more, whatever it confirmed before.
+   if (unit.m_dead.load(std::memory_order_acquire))
+      return UnitState::Failed;
+   // A later generation of the same state confirms this one too: the hardware has that state.
+   if (known && (open ? unit.m_ackedOpen : unit.m_ackedClosed).load(std::memory_order_acquire) >= generation)
+      return UnitState::Confirmed;
+   if (unit.m_failed.load(std::memory_order_acquire) >= generation)
+      return UnitState::Failed;
+   if (known && open && unit.m_untouched.load(std::memory_order_acquire) >= generation)
+      return UnitState::Untouched;
+   // Finished cleanly: what it confirmed or left alone stays so, and it delivers nothing later.
+   if (unit.m_stopped.load(std::memory_order_acquire))
+      return UnitState::Failed;
+   return UnitState::Pending;
+}
+
+OutputGate::Status OutputGate::GetState(int64_t generation, Counts& counts) const
+{
+   counts = Counts();
+   std::lock_guard<std::mutex> lock(m_mutex);
+   int64_t applied = Applied();
+   bool open = false;
+   bool recorded = StateOf(generation, open);
+   bool known = recorded && generation <= applied;
+   for (const auto& unit : m_units)
+   {
+      if (unit->m_session != m_session)
+         continue;
+      switch (Classify(*unit, generation, open, known))
+      {
+      case UnitState::Confirmed: counts.confirmed++; break;
+      case UnitState::Failed: counts.failed++; break;
+      case UnitState::Untouched: counts.untouched++; break;
+      default: counts.pending++; break;
+      }
+   }
+   if (!recorded)
+      // Never requested, or forgotten long ago.
+      return generation > applied ? Status::NotApplied : Status::Superseded;
+   if (!known)
+      return Status::NotApplied;
+   return IsSuperseded(generation, open, applied) ? Status::Superseded : Status::Applied;
+}
+
+std::vector<std::string> OutputGate::GetPending(int64_t generation) const
+{
+   std::vector<std::string> names;
+   std::lock_guard<std::mutex> lock(m_mutex);
+   int64_t applied = Applied();
+   bool open = false;
+   bool known = StateOf(generation, open) && generation <= applied;
+   for (const auto& unit : m_units)
+   {
+      if (unit->m_session != m_session)
+         continue;
+      UnitState state = Classify(*unit, generation, open, known);
+      if (state == UnitState::Pending || state == UnitState::Failed)
+         names.push_back(unit->m_name);
+   }
+   return names;
+}
+
+}
diff --git a/src/cab/out/OutputGate.h b/src/cab/out/OutputGate.h
new file mode 100644
index 0000000..b7480e3
--- /dev/null
+++ b/src/cab/out/OutputGate.h
@@ -0,0 +1,188 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace DOF
+{
+
+// Process-wide switch between the effects and the hardware, added for hosts that must be able to turn every output off
+// without losing the effect state (pause, faults). While the gate is closed, every output reports and sends 0; the
+// values the effects set are kept and sent again when it opens.
+//
+// A gate change gets a generation. DOF's main thread applies it (Pinball::SetOutputGate), and every output controller
+// unit acknowledges the state of a generation once a transfer to its hardware carried that state, so the host can tell
+// when the outputs are really off.
+class OutputGate
+{
+public:
+   // A generation and the state it set, read together.
+   struct Snapshot
+   {
+      int64_t generation;
+      bool open;
+   };
+
+   enum class Status
+   {
+      // The generation was not applied by DOF's main thread yet.
+      NotApplied,
+      Applied,
+      // A later generation that was published set the other state, or the generation is an opening that a latch
+      // overtook (requested before the latch, applied after it), which never reaches a unit as an opening. This does not
+      // change any more: only the latest generation's state tells what the outputs show.
+      Superseded,
+   };
+
+   struct Counts
+   {
+      // Units whose hardware got the state (or a later generation of the same state).
+      int confirmed = 0;
+      int pending = 0;
+      // The device is missing, a write failed, or the updater ended on its own. A unit that finished cleanly keeps what
+      // it confirmed or left alone, and fails later generations.
+      int failed = 0;
+      // Units DOF never used, left alone while the gate is open: nothing was written to them.
+      int untouched = 0;
+   };
+
+   class Unit
+   {
+   public:
+      // Called by the unit's updater before it copies the values it sends.
+      Snapshot Observe() const;
+      // Whether the hardware already got the state of `snapshot`, or the gate is open at a unit DOF leaves alone; until
+      // then the updater transfers every output.
+      bool IsAcked(const Snapshot& snapshot) const;
+      // A transfer to the hardware carried the state of `snapshot`.
+      void Ack(const Snapshot& snapshot);
+      // The gate is open at `snapshot` and DOF never used the unit, so nothing was written to its hardware.
+      void Untouched(const Snapshot& snapshot);
+      // The unit could not deliver `generation` (no device, failed write).
+      void Fail(int64_t generation);
+      // The unit's updater ended without being asked to: it fails every generation, also those it confirmed before.
+      void Die();
+      // The unit was finished: it delivers nothing any more. What it confirmed stays confirmed.
+      void Stop();
+
+   private:
+      friend class OutputGate;
+      std::string m_name;
+      uint64_t m_session = 0;
+      std::atomic<int64_t> m_ackedClosed { 0 };
+      std::atomic<int64_t> m_ackedOpen { 0 };
+      std::atomic<int64_t> m_untouched { 0 };
+      std::atomic<int64_t> m_failed { 0 };
+      std::atomic<bool> m_dead { false };
+      std::atomic<bool> m_stopped { false };
+   };
+
+   static OutputGate& Instance();
+
+   // The state outputs report. It changes before the generation that set it is published. The latch decides on its own,
+   // so an Apply that raced it cannot report the gate open again.
+   bool IsOpen() const { return !m_latched.load(std::memory_order_acquire) && m_open.load(std::memory_order_acquire); }
+   // Whether a controller may run its connect test sequence (TestOnConnect): only while the gate is open, and never in a
+   // session that turned them off, such as a port test, where a controller that connects late or reconnects would light
+   // its whole strip.
+   bool AllowsConnectTests() const { return IsOpen() && m_connectTests.load(std::memory_order_acquire); }
+   // Turns the connect test sequences off, or on again, for the current session. Every new session allows them.
+   void SetConnectTests(bool allowed) { m_connectTests.store(allowed, std::memory_order_release); }
+   Snapshot Current() const;
+
+   // Starts a new session: opens the gate and forgets the units and generations of the previous one.
+   void BeginSession();
+   // Registers an output controller unit of the current session, before its updater starts. The returned unit lives
+   // until the process ends.
+   Unit* Register(const std::string& name);
+   // Registers a configured unit that cannot deliver anything, such as a device that is not connected.
+   void RegisterFailed(const std::string& name);
+
+   // Reserves the generation of a change to `open` and records the requested state. Generations from the session's
+   // first latch on are closings.
+   int64_t Request(bool open);
+   // On DOF's main thread, in the order of the generations: sets the state outputs report and returns it, closed once
+   // latched. The caller re-raises the output values, then publishes the generation.
+   bool Apply(bool open);
+   // Any thread, at once: closes the gate for the rest of the session and publishes the closing, which every unit's
+   // updater sends within its polling interval, without DOF's main thread. Openings with an earlier generation that
+   // were not applied yet are never published as openings and report as superseded; every later change applies as a
+   // closing and reports the closed state. When latches race, the earliest generation is the session's latch, whatever
+   // order the threads finish in. Returns the closing's generation. It takes no lock and never allocates.
+   int64_t Latch();
+   bool IsLatched() const { return m_latched.load(std::memory_order_acquire); }
+   void Publish(int64_t generation);
+   int64_t Applied() const { return Current().generation; }
+
+   Status GetState(int64_t generation, Counts& counts) const;
+   // The units GetState counts as pending or failed for `generation`.
+   std::vector<std::string> GetPending(int64_t generation) const;
+
+private:
+   friend class OutputGateTestAccess;
+
