diff --git a/src/general/PathConfinement.cpp b/src/general/PathConfinement.cpp
new file mode 100644
index 0000000..4c48ae9
--- /dev/null
+++ b/src/general/PathConfinement.cpp
@@ -0,0 +1,146 @@
+#include "PathConfinement.h"
+
+#include <filesystem>
+#include <mutex>
+
+#include "../Log.h"
+
+namespace DOF
+{
+
+namespace
+{
+
+namespace fs = std::filesystem;
+
+struct Root
+{
+   // A root was given. Without one every path is allowed (upstream behavior).
+   bool set = false;
+   // The root resolved; if it did not, nothing is allowed.
+   bool valid = false;
+   fs::path path;
+};
+
+std::mutex s_mutex;
+Root s_root;
+thread_local bool t_hasRoot = false;
+thread_local Root t_root;
+
+Root MakeRoot(const std::string& root)
+{
+   Root r;
+   if (root.empty())
+      return r;
+   r.set = true;
+   std::error_code ec;
+   fs::path canonical = fs::canonical(fs::path(root), ec);
+   if (!ec && !canonical.empty())
+   {
+      r.valid = true;
+      r.path = canonical;
+   }
+   return r;
+}
+
+Root CurrentRoot()
+{
+   if (t_hasRoot)
+      return t_root;
+   std::lock_guard<std::mutex> lock(s_mutex);
+   return s_root;
+}
+
+// Resolves symbolic links and dot components of the parts that exist; the rest is normalized lexically. The result
+// stays a path: converting it to a narrow string can fail on Windows (a long name behind a short 8.3 path).
+bool Resolve(const std::string& path, fs::path& resolved)
+{
+   std::error_code ec;
+   fs::path absolute = fs::absolute(fs::path(path), ec);
+   if (ec)
+      return false;
+   resolved = fs::weakly_canonical(absolute, ec);
+   return !ec && !resolved.empty();
+}
+
+// Compares whole components, so neither a sibling with the same prefix ("config-other") nor a component that contains
+// a backslash on POSIX passes. Components compare exactly: canonical paths have the case of the file system.
+bool IsWithin(const fs::path& path, const fs::path& root)
+{
+   auto p = path.begin();
+   for (auto r = root.begin(); r != root.end(); ++r)
+   {
+      if (r->empty())
+         continue;
+      if (p == path.end() || *p != *r)
+         return false;
+      ++p;
+   }
+   for (; p != path.end(); ++p)
+   {
+      if (*p == fs::path(".."))
+         return false;
+   }
+   return true;
+}
+
+}
+
+void PathConfinement::SetRoot(const std::string& root)
+{
+   Root r = MakeRoot(root);
+   if (r.set && !r.valid)
+      Log::Warning("The configuration folder " + root + " cannot be resolved: no file will be read.");
+   std::lock_guard<std::mutex> lock(s_mutex);
+   s_root = r;
+}
+
+bool PathConfinement::HasRoot() { return CurrentRoot().set; }
+
+PathConfinement::ThreadRoot::ThreadRoot(const std::string& root)
+   : m_hadRoot(t_hasRoot)
+   , m_previous(new Root(t_root))
+{
+   t_root = MakeRoot(root);
+   t_hasRoot = true;
+}
+
+PathConfinement::ThreadRoot::~ThreadRoot()
+{
+   t_root = *static_cast<Root*>(m_previous);
+   t_hasRoot = m_hadRoot;
+   delete static_cast<Root*>(m_previous);
+}
+
+bool PathConfinement::IsReadAllowed(const std::string& path)
+{
+   Root root = CurrentRoot();
+   if (!root.set)
+      return true;
+   bool allowed = false;
+   if (root.valid && !path.empty())
+   {
+      try
+      {
+         fs::path resolved;
+         allowed = Resolve(path, resolved) && IsWithin(resolved, root.path);
+      }
+      catch (...)
+      {
+         allowed = false;
+      }
+   }
+   if (!allowed)
+      Log::Warning("Not reading " + path + ": it is outside the configuration folder.");
+   return allowed;
+}
+
+bool PathConfinement::IsWriteAllowed(const std::string& path)
+{
+   if (!HasRoot())
+      return true;
+   Log::Warning("Not writing or deleting " + path + ": the configuration folder is read-only.");
+   return false;
+}
+
+}
diff --git a/src/general/PathConfinement.h b/src/general/PathConfinement.h
new file mode 100644
index 0000000..9319509
--- /dev/null
+++ b/src/general/PathConfinement.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <string>
+
+namespace DOF
+{
+
+// VPE: keeps libdof's file access inside one folder. Configurations are imported from elsewhere, and their paths and
+// placeholders must not make libdof read files outside the folder they were imported into, or write or delete any file.
+class PathConfinement
+{
+public:
+   // Folder that reads are limited to. Empty allows every path (upstream behavior); writes and deletions are always
+   // refused while a root is set. A root that does not resolve allows nothing.
+   static void SetRoot(const std::string& root);
+   static bool HasRoot();
+   // Whether the path, with its symbolic links and dot components resolved, lies inside the root. Any error denies.
+   static bool IsReadAllowed(const std::string& path);
+   static bool IsWriteAllowed(const std::string& path);
+
+   // Confines the calling thread to another root while it exists (catalog queries next to a running session).
+   class ThreadRoot
+   {
+   public:
+      explicit ThreadRoot(const std::string& root);
+      ~ThreadRoot();
+
+   private:
+      bool m_hadRoot;
+      void* m_previous;
+   };
+};
+
+}
