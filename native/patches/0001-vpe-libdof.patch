diff --git a/src/cab/out/OutputGate.cpp b/src/cab/out/OutputGate.cpp
new file mode 100644
index 0000000..824f940
--- /dev/null
+++ b/src/cab/out/OutputGate.cpp
@@ -0,0 +1,220 @@
+#include "OutputGate.h"
+
+#include <cstdint>
+
+namespace DOF
+{
+
+namespace
+{
+
+void RaiseTo(std::atomic<int64_t>& value, int64_t generation)
+{
+   int64_t current = value.load(std::memory_order_relaxed);
+   while (current < generation && !value.compare_exchange_weak(current, generation, std::memory_order_release, std::memory_order_relaxed))
+   {
+   }
+}
+
+}
+
+OutputGate::Snapshot OutputGate::Unit::Observe() const { return OutputGate::Instance().Current(); }
+
+bool OutputGate::Unit::IsAcked(const Snapshot& snapshot) const
+{
+   const std::atomic<int64_t>& acked = snapshot.open ? m_ackedOpen : m_ackedClosed;
+   return acked.load(std::memory_order_acquire) >= snapshot.generation;
+}
+
+void OutputGate::Unit::Ack(const Snapshot& snapshot) { RaiseTo(snapshot.open ? m_ackedOpen : m_ackedClosed, snapshot.generation); }
+
+void OutputGate::Unit::Fail(int64_t generation) { RaiseTo(m_failed, generation); }
+
+void OutputGate::Unit::Die() { Fail(INT64_MAX); }
+
+void OutputGate::Unit::Stop() { m_stopped.store(true, std::memory_order_release); }
+
+OutputGate& OutputGate::Instance()
+{
+   static OutputGate instance;
+   return instance;
+}
+
+OutputGate::Snapshot OutputGate::Current() const
+{
+   int64_t word = m_published.load(std::memory_order_acquire);
+   return { word >> 1, (word & 1) != 0 };
+}
+
+void OutputGate::BeginSession()
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   m_session++;
+   int64_t generation = ++m_requested;
+   Record(generation, true);
+   Reserve();
+   m_latched.store(false, std::memory_order_release);
+   m_open.store(true, std::memory_order_release);
+   m_published.store(Pack(generation, true), std::memory_order_release);
+   // Units of earlier sessions stay allocated, since a hung updater thread of an abandoned session may still use its
+   // unit, but they are no longer scanned.
+   for (auto& unit : m_units)
+      m_retired.push_back(std::move(unit));
+   m_units.clear();
+}
+
+OutputGate::Unit* OutputGate::Register(const std::string& name)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto unit = std::make_unique<Unit>();
+   unit->m_name = name;
+   unit->m_session = m_session;
+   Unit* result = unit.get();
+   m_units.push_back(std::move(unit));
+   return result;
+}
+
+void OutputGate::RegisterFailed(const std::string& name) { Register(name)->Die(); }
+
+int64_t OutputGate::Request(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   int64_t generation = ++m_requested;
+   Record(generation, open && !m_latched.load(std::memory_order_relaxed));
+   Reserve();
+   return generation;
+}
+
+void OutputGate::Record(int64_t generation, bool open)
+{
+   m_history[generation] = open;
+   while (m_history.size() > MaxHistory)
+      m_history.erase(m_history.begin());
+}
+
+void OutputGate::Reserve()
+{
+   while (m_spares.size() < SpareNodes)
+   {
+      std::map<int64_t, bool> scratch;
+      scratch.emplace(0, false);
+      m_spares.push_back(scratch.extract(scratch.begin()));
+   }
+}
+
+bool OutputGate::Apply(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mutex);
+   if (m_latched.load(std::memory_order_relaxed))
+      open = false;
+   m_open.store(open, std::memory_order_release);
+   return open;
+}
+
+int64_t OutputGate::Latch()
+{
+   int64_t generation;
+   {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      m_latched.store(true, std::memory_order_release);
+      m_open.store(false, std::memory_order_release);
+      // Openings still queued for the main thread are obsolete: they apply as closings.
+      for (auto it = m_history.upper_bound(Applied()); it != m_history.end(); ++it)
+         it->second = false;
+      generation = ++m_requested;
+      // Never allocates: a reserved node, or the oldest entry once the history is full or the reserve ran out (more
+      // than SpareNodes latches in a row). A forgotten generation reports as superseded, which an old one is anyway.
+      std::map<int64_t, bool>::node_type node;
+      if (m_history.size() < MaxHistory && !m_spares.empty())
+      {
+         node = std::move(m_spares.back());
+         m_spares.pop_back();
+      }
+      else if (!m_history.empty())
+         node = m_history.extract(m_history.begin());
+      // Without a node the generation goes unrecorded, and Publish takes the closed state from m_open.
+      if (node)
+      {
+         node.key() = generation;
+         node.mapped() = false;
+         m_history.insert(std::move(node));
+      }
+   }
+   // Published at once, so the updaters send zeros without waiting for the main thread.
+   Publish(generation);
+   return generation;
+}
+
+void OutputGate::Publish(int64_t generation)
+{
+   bool open;
+   {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      auto it = m_history.find(generation);
+      open = it != m_history.end() ? it->second : m_open.load(std::memory_order_acquire);
+   }
+   int64_t current = m_published.load(std::memory_order_relaxed);
+   int64_t word = Pack(generation, open);
+   while ((current >> 1) < generation && !m_published.compare_exchange_weak(current, word, std::memory_order_release, std::memory_order_relaxed))
+   {
+   }
+}
+
+bool OutputGate::IsSuperseded(int64_t generation, bool open, int64_t applied) const
+{
+   for (auto it = m_history.upper_bound(generation); it != m_history.end() && it->first <= applied; ++it)
+   {
+      if (it->second != open)
+         return true;
+   }
+   return false;
+}
+
+bool OutputGate::IsConfirmed(const Unit& unit, int64_t generation, bool open) const
+{
+   // A later generation of the same state confirms this one too: the hardware has that state.
+   return (open ? unit.m_ackedOpen : unit.m_ackedClosed).load(std::memory_order_acquire) >= generation;
+}
+
+OutputGate::Status OutputGate::GetState(int64_t generation, int& confirmed, int& pending, int& failed) const
+{
+   confirmed = pending = failed = 0;
+   std::lock_guard<std::mutex> lock(m_mutex);
+   int64_t applied = Applied();
+   auto it = m_history.find(generation);
+   if (it == m_history.end())
+      // Never requested, or forgotten long ago.
+      return generation > applied ? Status::NotApplied : Status::Superseded;
+   bool open = it->second;
+   for (const auto& unit : m_units)
+   {
+      if (unit->m_session != m_session)
+         continue;
+      if (IsConfirmed(*unit, generation, open))
+         confirmed++;
+      else if (unit->m_stopped.load(std::memory_order_acquire) || unit->m_failed.load(std::memory_order_acquire) >= generation)
+         failed++;
+      else
+         pending++;
+   }
+   if (generation > applied)
+      return Status::NotApplied;
+   return IsSuperseded(generation, open, applied) && pending + failed > 0 ? Status::Superseded : Status::Applied;
+}
+
+std::vector<std::string> OutputGate::GetPending(int64_t generation) const
+{
+   std::vector<std::string> names;
+   std::lock_guard<std::mutex> lock(m_mutex);
+   auto it = m_history.find(generation);
+   for (const auto& unit : m_units)
+   {
+      if (unit->m_session != m_session)
+         continue;
+      if (it == m_history.end() || !IsConfirmed(*unit, generation, it->second))
+         names.push_back(unit->m_name);
+   }
+   return names;
+}
+
+}
diff --git a/src/cab/out/OutputGate.h b/src/cab/out/OutputGate.h
new file mode 100644
index 0000000..672ad8f
--- /dev/null
+++ b/src/cab/out/OutputGate.h
@@ -0,0 +1,132 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace DOF
+{
+
+// Process-wide switch between the effects and the hardware, added for hosts that must be able to turn every output off
+// without losing the effect state (pause, faults). While the gate is closed, every output reports and sends 0; the
+// values the effects set are kept and sent again when it opens.
+//
+// A gate change gets a generation. DOF's main thread applies it (Pinball::SetOutputGate), and every output controller
+// unit acknowledges the state of a generation once a transfer to its hardware carried that state, so the host can tell
+// when the outputs are really off.
+class OutputGate
+{
+public:
+   // A generation and the state it set, read together.
+   struct Snapshot
+   {
+      int64_t generation;
+      bool open;
+   };
+
+   enum class Status
+   {
+      // The generation was not applied by DOF's main thread yet.
+      NotApplied,
+      Applied,
+      // A later generation set the other state while some unit had not confirmed this one. Only the latest
+      // generation's state tells what the outputs show; an older one can later count as confirmed by every unit.
+      Superseded,
+   };
+
+   class Unit
+   {
+   public:
+      // Called by the unit's updater before it copies the values it sends.
+      Snapshot Observe() const;
+      // Whether the hardware already got the state of `snapshot`; until then the updater transfers every output.
+      bool IsAcked(const Snapshot& snapshot) const;
+      // A transfer to the hardware carried the state of `snapshot`.
+      void Ack(const Snapshot& snapshot);
+      // The unit could not deliver `generation` (no device, failed write).
+      void Fail(int64_t generation);
+      // The unit's updater ended without being asked to: it fails every later generation.
+      void Die();
+      // The unit was finished: it delivers nothing any more. What it confirmed stays confirmed.
+      void Stop();
+
+   private:
+      friend class OutputGate;
+      std::string m_name;
+      uint64_t m_session = 0;
+      std::atomic<int64_t> m_ackedClosed { 0 };
+      std::atomic<int64_t> m_ackedOpen { 0 };
+      std::atomic<int64_t> m_failed { 0 };
+      std::atomic<bool> m_stopped { false };
+   };
+
+   static OutputGate& Instance();
+
+   // The state outputs report. It changes before the generation that set it is published.
+   bool IsOpen() const { return m_open.load(std::memory_order_acquire); }
+   Snapshot Current() const;
+
+   // Starts a new session: opens the gate and forgets the units of the previous one.
+   void BeginSession();
+   // Registers an output controller unit of the current session, before its updater starts. The returned unit lives
+   // until the process ends.
+   Unit* Register(const std::string& name);
+   // Registers a configured unit that cannot deliver anything, such as a device that is not connected.
+   void RegisterFailed(const std::string& name);
+
+   // Reserves the generation of a change to `open`. Once latched, every change is a closing.
+   int64_t Request(bool open);
+   // On DOF's main thread, in the order of the generations: sets the state outputs report and returns it, closed once
+   // latched. The caller re-raises the output values, then publishes the generation.
+   bool Apply(bool open);
+   // Any thread, at once: closes the gate for the rest of the session and publishes the closing, which every unit's
+   // updater sends within its polling interval, without DOF's main thread. Openings requested and not applied yet, and
+   // every later one, apply as closings, and their generations report the closed state. Returns the closing's
+   // generation. It never allocates: the closing's history entry is a node reserved by the other calls or, once they
+   // ran out, the oldest entry's.
+   int64_t Latch();
+   bool IsLatched() const { return m_latched.load(std::memory_order_acquire); }
+   void Publish(int64_t generation);
+   int64_t Applied() const { return Current().generation; }
+
+   Status GetState(int64_t generation, int& confirmed, int& pending, int& failed) const;
+   // The units that did not confirm `generation`, failed ones included.
+   std::vector<std::string> GetPending(int64_t generation) const;
+
+private:
+   OutputGate() { m_spares.reserve(SpareNodes); }
+
+   static int64_t Pack(int64_t generation, bool open) { return (generation << 1) | (open ? 1 : 0); }
+
+   // Called with m_mutex held.
+   bool IsSuperseded(int64_t generation, bool open, int64_t applied) const;
+   bool IsConfirmed(const Unit& unit, int64_t generation, bool open) const;
+
+   std::atomic<bool> m_open { true };
+   // Written with m_mutex held.
+   std::atomic<bool> m_latched { false };
+   // The last published generation and its state: (generation << 1) | open.
+   std::atomic<int64_t> m_published { Pack(0, true) };
+   int64_t m_requested = 0;
+   uint64_t m_session = 0;
+   mutable std::mutex m_mutex;
+   // The state each generation set, the latest ones only.
+   std::map<int64_t, bool> m_history;
+   // History nodes reserved for Latch, which must not allocate. Refilled, with m_mutex held, by the other calls.
+   std::vector<std::map<int64_t, bool>::node_type> m_spares;
+   std::vector<std::unique_ptr<Unit>> m_units;
+   std::vector<std::unique_ptr<Unit>> m_retired;
+
+   static constexpr size_t MaxHistory = 4096;
+   static constexpr size_t SpareNodes = 8;
+
+   // Called with m_mutex held. Records the state of a generation and forgets the oldest ones.
+   void Record(int64_t generation, bool open);
+   void Reserve();
+};
+
+}
