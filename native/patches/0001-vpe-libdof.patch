+bool Pinball::Post(std::function<void()> command)
+{
+   {
+      std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+      if (!m_keepMainThreadAlive || !IsMainThreadActive())
+         return false;
+      m_commands.push_back(std::move(command));
+      m_mainThreadDoWork = true;
+   }
+   m_mainThreadCV.notify_one();
+   return true;
+}
+
+int64_t Pinball::SetOutputGate(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+   if (!m_keepMainThreadAlive || !IsMainThreadActive())
+      return -1;
+   int64_t generation = OutputGate::Instance().Request(open);
+   m_commands.push_back([this, open, generation]() { ApplyOutputGate(open, generation); });
+   m_mainThreadDoWork = true;
+   m_mainThreadCV.notify_one();
+   return generation;
+}
+
+void Pinball::ApplyOutputGate(bool open, int64_t generation)
+{
+   OutputGate& gate = OutputGate::Instance();
+   bool wasOpen = gate.IsOpen();
+   // A latched gate applies an opening as a closing.
+   open = gate.Apply(open);
+   if (wasOpen != open)
+   {
+      // Outputs with a value now report another one: tell their controllers. Outputs at 0 report 0 either way.
+      OutputControllerList* controllers = m_cabinet ? m_cabinet->GetOutputControllers() : nullptr;
+      if (controllers)
+      {
+         for (IOutputController* controller : *controllers)
+         {
+            OutputList* outputs = controller ? controller->GetOutputs() : nullptr;
+            if (!outputs)
+               continue;
+            for (IOutput* output : *outputs)
+            {
+               if (output && output->IsGated() && output->GetRequestedOutput() != 0)
+                  output->RaiseValueChanged();
+            }
+         }
+      }
+   }
+   // Controllers read the generation before they copy the values they send, so they see the values stored above.
+   gate.Publish(generation);
+   if (m_cabinet)
+      m_cabinet->Update();
+}
+
+int Pinball::GetPendingInputCount() const { return m_inputQueue ? m_inputQueue->Count() : 0; }
+
 }
