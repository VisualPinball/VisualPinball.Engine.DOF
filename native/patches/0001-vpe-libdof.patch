+bool Pinball::Post(std::function<void()> command)
+{
+   {
+      std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+      if (!m_keepMainThreadAlive || !IsMainThreadActive())
+         return false;
+      m_commands.push_back({ m_inputQueue->Count(), std::move(command) });
+      m_mainThreadDoWork = true;
+   }
+   m_mainThreadCV.notify_one();
+   return true;
+}
+
+int64_t Pinball::SetOutputGate(bool open)
+{
+   std::lock_guard<std::mutex> lock(m_mainThreadMutex);
+   if (m_stopping)
+      // A closing still goes out without the main thread, before or with the final blackout.
+      return open ? -1 : m_gate->Latch();
+   if (!m_keepMainThreadAlive || !IsMainThreadActive())
+      return -1;
+   int64_t generation = m_gate->Request(open);
+   m_commands.push_back({ m_inputQueue->Count(), [this, open, generation]() { ApplyOutputGate(open, generation); } });
+   m_mainThreadDoWork = true;
+   m_mainThreadCV.notify_one();
+   return generation;
+}
+
+namespace
+{
+
+// Runs one step of a gate change and logs what it throws, so the other steps still run: every output is re-raised and
+// the generation is published whatever one effect, toy or controller does.
+template <typename Step> void RunGateStep(const char* what, Step&& step)
+{
+   try
+   {
+      step();
+   }
+   catch (const std::exception& e)
+   {
+      Log::Exception(StringExtensions::Build("An exception occured while applying the output gate ({0}): {1}", what, e.what()));
+   }
+   catch (...)
+   {
+      Log::Exception(StringExtensions::Build("An exception occured while applying the output gate ({0})", what));
+   }
+}
+
+}
+
+void Pinball::ApplyOutputGate(bool open, int64_t generation)
+{
+   OutputGate& gate = *m_gate;
+   bool wasOpen = gate.IsOpen();
+   // The toys get the input processed before this change. An opening updates them while the gate is still closed, a
+   // closing once it is closed, so neither sends a value the gate should hold back.
+   if (open && m_cabinet && m_cabinet->GetToys())
+      RunGateStep("toys", [this]() { m_cabinet->GetToys()->UpdateOutputs(); });
+   // A latched gate applies an opening as a closing.
+   open = gate.Apply(open);
+   if (!open && m_cabinet && m_cabinet->GetToys())
+      RunGateStep("toys", [this]() { m_cabinet->GetToys()->UpdateOutputs(); });
+   if (wasOpen != open)
+   {
+      // Outputs with a value now report another one: tell their controllers. Outputs at 0 report 0 either way.
+      OutputControllerList* controllers = m_cabinet ? m_cabinet->GetOutputControllers() : nullptr;
+      if (controllers)
+      {
+         for (IOutputController* controller : *controllers)
+         {
+            OutputList* outputs = controller ? controller->GetOutputs() : nullptr;
+            if (!outputs)
+               continue;
+            for (IOutput* output : *outputs)
+            {
+               if (output && output->IsGated() && output->GetRequestedOutput() != 0)
+                  RunGateStep("outputs", [output]() { output->RaiseValueChanged(); });
+            }
+         }
+      }
+   }
+   // Controllers read the generation before they copy the values they send, so they see the values stored above.
+   gate.Publish(generation);
+   if (m_cabinet)
+      m_cabinet->Update();
+}
+
+int Pinball::GetPendingInputCount() const { return m_inputQueue ? m_inputQueue->Count() : 0; }
+
 }
