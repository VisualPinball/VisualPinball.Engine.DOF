/* libusb configuration for VpeDof's POSIX builds (Linux and macOS), in place of the one autotools generates. */

/* Static inside VpeDof: libusb's API stays private to the library. */
#define DEFAULT_VISIBILITY
#define ENABLE_LOGGING 1
#define PLATFORM_POSIX 1
#define HAVE_NFDS_T 1
#define HAVE_SYS_TIME_H 1
#define PRINTF_FORMAT(a, b) __attribute__ ((__format__ (__printf__, a, b)))
#ifndef _GNU_SOURCE
#define _GNU_SOURCE 1
#endif

#cmakedefine HAVE_CLOCK_GETTIME 1
#cmakedefine HAVE_PIPE2 1
#cmakedefine HAVE_EVENTFD 1
#cmakedefine HAVE_TIMERFD 1
#cmakedefine HAVE_ASM_TYPES_H 1
#cmakedefine HAVE_PTHREAD_THREADID_NP 1
#cmakedefine HAVE_PTHREAD_SETNAME_NP 1
#cmakedefine HAVE_STRUCT_TIMESPEC 1
