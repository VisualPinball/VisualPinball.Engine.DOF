/* libserialport configuration for VpeDof's POSIX builds (Linux and macOS), in place of the one autotools generates. */

#define SP_PACKAGE_VERSION_MAJOR 0
#define SP_PACKAGE_VERSION_MINOR 1
#define SP_PACKAGE_VERSION_MICRO 2
#define SP_PACKAGE_VERSION_STRING "0.1.2"
#define SP_LIB_VERSION_CURRENT 1
#define SP_LIB_VERSION_REVISION 1
#define SP_LIB_VERSION_AGE 1
#define SP_LIB_VERSION_STRING "1:1:1"

/* Static inside VpeDof: the API stays private to the library. */
#define SP_API
#define SP_PRIV __attribute__((visibility("hidden")))

#cmakedefine HAVE_REALPATH 1
#cmakedefine HAVE_SYS_FILE_H 1
#cmakedefine HAVE_FLOCK 1
#cmakedefine HAVE_CLOCK_GETTIME 1
#cmakedefine HAVE_STRUCT_TERMIOS2 1
#cmakedefine HAVE_STRUCT_TERMIOS_C_ISPEED 1
#cmakedefine HAVE_STRUCT_TERMIOS_C_OSPEED 1
#cmakedefine HAVE_STRUCT_TERMIOS2_C_ISPEED 1
#cmakedefine HAVE_STRUCT_TERMIOS2_C_OSPEED 1
#cmakedefine01 HAVE_DECL_BOTHER
#cmakedefine HAVE_STRUCT_SERIAL_STRUCT 1

/* As libserialport's configure.ac: the speed fields let it set non-standard rates (PinOne runs at 2,000,000 baud). */
#if HAVE_STRUCT_TERMIOS_C_ISPEED && HAVE_STRUCT_TERMIOS_C_OSPEED
# define HAVE_TERMIOS_SPEED 1
#endif
#if HAVE_STRUCT_TERMIOS2_C_ISPEED && HAVE_STRUCT_TERMIOS2_C_OSPEED
# define HAVE_TERMIOS2_SPEED 1
#endif
